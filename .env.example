# Host UID/GID used inside the container for /data ownership
PUID=1000
PGID=1000

# Published host HTTP port
AURISDECK_PORT=8080

# Authentication mode: "none" or "password"
AURISDECK_AUTH_MODE=none
AURISDECK_AUTH_PASSWORD=

# Optional subpath if served behind a reverse proxy (e.g. /aurisdeck)
AURISDECK_BASE_PATH=

# Optional Hugging Face Hub token (required only for gated diarization models)
HF_TOKEN=

# Optional custom Hugging Face Hub endpoint or mirror
HF_ENDPOINT=
